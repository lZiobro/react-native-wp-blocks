          }
        >
          <Text>
            &lt;View&gt;
  &lt;View&gt;
    &lt;Text&gt; a link to: &lt;/Text&gt;
    &lt;Text onPress={...}&gt;
      google.com
    // thanks to tokenization we are closing Text
    // before adding an Image
    &lt;/Text&gt;
    // Image is no longer nested in the Text!
    &lt;Image src="..." /&gt;
  &lt;/View&gt;
&lt;/View&gt;
          </Text>
        </Text>
      </Text>
    </Text>
