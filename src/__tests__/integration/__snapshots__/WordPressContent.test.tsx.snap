exports[`WordPress Example Fixture Snapshots matches snapshot for Full Article Example 1`] = `
<>
  <View
    style={
      {
        "marginVertical": 5,
      }
    }
  >
    <Text
      style={
        [
          {},
          {},
        ]
      }
    >
      <Text
        style={
          [
            {},
            {},
          ]
        }
      >
        <Text>
          Translating Gutenberg blocks into React Native components is pretty complicated. It requires handling a lot of different cases, parsing attributes and is overall just a bad experience. But it doesn't have to be!
        </Text>
      </Text>
    </Text>
  </View>
  <View
    style={
      {
        "marginVertical": 5,
      }
    }
  >
    <Text
      style={
        {
          "fontSize": 24,
          "fontWeight": 700,
